# .env.example — copy to .env and fill in real values.
# .env is gitignored; never commit real secrets. (OneDrive note: a .env here
# syncs to the cloud — to avoid that, set vars per-shell instead of a file.)

# ── Required: direct Postgres connection for all Python scripts ──────────────
# Supabase → Project Settings → Database → Connection string (URI).
# Use the pooler URI (port 6543) on a pooled tier, else direct (5432).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── Supabase REST (frontend / Vercel; also handy for local tooling) ─────────
SB_URL=https://YOUR-PROJECT.supabase.co
SB_KEY=YOUR_SUPABASE_ANON_KEY        # anon key — NOT the DB password above

# ── Claude proxy (Vercel: api/scout.js) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Pre-filters the sidebar to one team (Vercel) ────────────────────────────
DEFAULT_TEAM=Seattle Mariners

# ── fetch_kalshi_outcomes.py only ───────────────────────────────────────────
# Vegas h2h lines (The Odds API). Optional — script degrades to no Vegas data.
ODDS_API_KEY=
# Kalshi API auth. KALSHI_PRIVATE_KEY is a PEM; inline it with literal \n
# escapes, or instead drop the PEM at ./kalshi_private.pem and leave this blank.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# ── Per-run knobs (set inline when running, not usually stored here) ─────────
# MODE          fetch_kalshi_outcomes.py: morning|pregame|outcomes|backfill-cycle
#               fetch_game_results.py:     nightly|backfill
# SEASON        e.g. 2026   (validate_model.py, backfill_*.py, fetch_game_results.py)
# DAYS          backtest window (tune_model.py, fetch_backtest_cache.py, compare_weights.py)
# GAME_DATE     fetch_game_predictions.py target date (YYYY-MM-DD)
# BACKFILL_START / SPLIT_DATE / OUTPUT   backfill + split-backtest helpers
